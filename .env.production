# API Configuration
REACT_APP_API_URL=https://poker-pro-analytics.windsurf.build

# Monitoring
REACT_APP_SENTRY_DSN=${SENTRY_DSN}
REACT_APP_APM_SERVER_URL=${APM_SERVER_URL}

# Analytics
REACT_APP_GA_ID=${GA_ID}

# Environment
REACT_APP_ENVIRONMENT=production

# Application Features
REACT_APP_ENABLE_TOURNAMENTS=true
REACT_APP_ENABLE_ICM=true
REACT_APP_ENABLE_HAND_ANALYSIS=true
